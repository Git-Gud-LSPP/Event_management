PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/event_management

JWT_SECRET=your_super_secret_key_for_development
JWT_EXPIRES_IN=1h


# AI agent: "<provider>:<model id>". Providers wired in agent/agent.service.js: anthropic, openai, google, local.
AGENT_MODEL=anthropic:claude-opus-5-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# Local models via any OpenAI-compatible server (Ollama, LM Studio, vLLM, llama.cpp --server).
# e.g. AGENT_MODEL=local:llama3.1  (Ollama) or AGENT_MODEL=local:qwen2.5-7b-instruct (LM Studio).
# Native run: the backend sees your host network, so localhost works.
# LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
# Docker run: localhost inside the container is the container itself, so point at
# the host via host.docker.internal (docker-compose.yml already defaults to this).
# LOCAL_MODEL_BASE_URL=http://host.docker.internal:11434/v1
# LOCAL_MODEL_API_KEY=ollama
